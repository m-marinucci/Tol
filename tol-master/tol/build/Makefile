	$(MAKE) $(MAKESILENT) -f OIS/CMakeFiles/COPY_HDR_OIS.dir/build.make OIS/CMakeFiles/COPY_HDR_OIS.dir/build
.PHONY : COPY_HDR_OIS/fast

init.o: init.cpp.o
.PHONY : init.o

# target to build an object file
init.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tol_init.dir/build.make CMakeFiles/tol_init.dir/init.cpp.o
.PHONY : init.cpp.o

init.i: init.cpp.i
.PHONY : init.i

# target to preprocess a source file
init.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tol_init.dir/build.make CMakeFiles/tol_init.dir/init.cpp.i
.PHONY : init.cpp.i

init.s: init.cpp.s
.PHONY : init.s

# target to generate assembly for a file
init.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tol_init.dir/build.make CMakeFiles/tol_init.dir/init.cpp.s
.PHONY : init.cpp.s

