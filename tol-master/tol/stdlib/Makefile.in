	dir='$(DESTDIR)$(pkgconfigdir)'; $(am__uninstall_files_from_dir)
install-recursive_dirDATA: $(recursive_dir_DATA)
	@$(NORMAL_INSTALL)
	@list='$(recursive_dir_DATA)'; test -n "$(recursive_dirdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(recursive_dirdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(recursive_dirdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(recursive_dirdir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(recursive_dirdir)" || exit $$?; \
	done

