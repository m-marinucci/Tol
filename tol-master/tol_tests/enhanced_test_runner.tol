  @EnhancedBatteryConfig("memory_leak_detection", "memory_tests/leak_detection", 1, "ALL", 600, 200),
  @EnhancedBatteryConfig("memory_stress_test", "memory_tests/stress", 1, "ALL", 1200, 1000)
