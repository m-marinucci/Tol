//////////////////////////////////////////////////////////////////////////////
// FILE   : test.tol
// PURPOSE: Cross-platform compatibility tests
// AUTHOR : Massimiliano Marinucci
// DATE   : 2025-07-06
// ISSUE  : NUM-11 - P0: Comprehensive Cross-Platform Testing Framework
//////////////////////////////////////////////////////////////////////////////

Text email_   = "mmarinucci@numinate.com"; 
Text link_    = "https://linear.app/numinate/issue/NUM-11";
Text summary_ = "Cross-platform compatibility validation tests";

Real numErr0 = Copy(NError);

//////////////////////////////////////////////////////////////////////////////
// Platform Detection and Information
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing platform detection and information...");

// Get platform information
Real platformId = GetHardSoftPlattform(0);
Text platformStr = "";

// Determine platform string based on ID
If(platformId == 1, { platformStr = "Linux_x86_32" });
If(platformId == 2, { platformStr = "Linux_x86_64" });
If(platformId == 3, { platformStr = "Windows_x86_32" });
If(platformId == 4, { platformStr = "Windows_x86_64" });
If(platformStr == "", { platformStr = "Unknown_Platform" });

WriteLn("Detected Platform: " + platformStr);

Real test1 = Length(platformStr) > 0;

If(!test1, { 
  WriteLn("FAIL: Platform detection");
});

//////////////////////////////////////////////////////////////////////////////
// Test 2: Numerical Precision Consistency
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing numerical precision consistency across platforms...");

Real pi = 3.14159265358979323846;
Real e = 2.71828182845904523536;
Real sqrt2 = Sqrt(2);

// Test that mathematical constants are consistent
Real tolerance = 1e-10;
Real test2 = And(
  Abs(Sin(pi/2) - 1.0) < tolerance,
  Abs(Exp(1) - e) < tolerance,
  Abs(sqrt2 * sqrt2 - 2.0) < tolerance
);

If(!test2, { 
  WriteLn("FAIL: Numerical precision consistency");
  WriteLn("Sin(π/2): " + Text(Sin(pi/2)));
  WriteLn("Exp(1): " + Text(Exp(1)));
  WriteLn("√2 * √2: " + Text(sqrt2 * sqrt2));
});

//////////////////////////////////////////////////////////////////////////////
// Test 3: String Handling Consistency
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing string handling consistency...");

Text testStr = "Hello, World! 123 αβγ";
Real length = Length(testStr);
Text upperCase = UpCase(testStr);
Text lowerCase = LowCase(testStr);

Real test3 = And(
  length > 0,
  Length(upperCase) == length,
  Length(lowerCase) == length
);

If(!test3, { 
  WriteLn("FAIL: String handling consistency");
  WriteLn("Original length: " + Text(length));
  WriteLn("Upper case length: " + Text(Length(upperCase)));
  WriteLn("Lower case length: " + Text(Length(lowerCase)));
});

//////////////////////////////////////////////////////////////////////////////
// Test 4: File Path Handling
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing file path handling...");

Text currentDir = ".";
Text parentDir = "..";
Text testPath = currentDir + "/test_file.txt";

Real test4 = And(
  Length(currentDir) > 0,
  Length(parentDir) > 0,
  Length(testPath) > Length(currentDir)
);

If(!test4, { 
  WriteLn("FAIL: File path handling");
});

//////////////////////////////////////////////////////////////////////////////
// Test 5: Date and Time Consistency
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing date and time consistency...");

Date currentDate = Today();
Text dateStr = Text(currentDate);
Real year = Year(currentDate);
Real month = Month(currentDate);
Real day = Day(currentDate);

Real test5 = And(
  year >= 2025,
  month >= 1,
  month <= 12,
  day >= 1,
  day <= 31,
  Length(dateStr) > 0
);

If(!test5, { 
  WriteLn("FAIL: Date and time consistency");
  WriteLn("Year: " + Text(year));
  WriteLn("Month: " + Text(month));
  WriteLn("Day: " + Text(day));
});

//////////////////////////////////////////////////////////////////////////////
// Test 6: Memory Management Consistency
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing memory management consistency...");

// Test memory allocation and deallocation patterns
Matrix m1 = MatRand(100, 100);
Matrix m2 = MatRand(100, 100);
Matrix m3 = m1 + m2;
Matrix m4 = m1 * m2;

Real test6 = And(
  Rows(m3) == 100,
  Cols(m3) == 100,
  Rows(m4) == 100,
  Cols(m4) == 100
);

If(!test6, { 
  WriteLn("FAIL: Memory management consistency");
});

//////////////////////////////////////////////////////////////////////////////
// Test 7: Character Encoding Compatibility (PR 26 Fix)
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing character encoding compatibility...");

// Test the character encoding fixes from PR 26
Text asciiChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
Text specialChars = "!@#$%^&*()_+-=[]{}|;:,.<>?";
Text controlChar = "\\x01"; // The fix from PR 26

Real test7 = And(
  Length(asciiChars) == 62,
  Length(specialChars) > 0,
  Length(controlChar) > 0
);

If(!test7, { 
  WriteLn("FAIL: Character encoding compatibility");
});

//////////////////////////////////////////////////////////////////////////////
// Test 8: Hash Map Compatibility (PR 26 Fix)
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing hash map compatibility...");

// Test that hash-based operations work consistently
// This indirectly tests the hash map compatibility fixes from PR 26
Set testSet = [[ "apple", "banana", "cherry", "date", "elderberry" ]];
Real setSize = Card(testSet);
Real expectedSize = 5;

Real test8 = EQ(setSize, expectedSize);

If(!test8, { 
  WriteLn("FAIL: Hash map compatibility");
  WriteLn("Set size: " + Text(setSize) + " (expected " + Text(expectedSize) + ")");
});

//////////////////////////////////////////////////////////////////////////////
// Test 9: Mathematical Library Consistency
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing mathematical library consistency...");

// Test that mathematical functions produce consistent results
Real angle = pi / 4;
Real sinVal = Sin(angle);
Real cosVal = Cos(angle);
Real tanVal = Tan(angle);
Real atanVal = ATan(1.0);

Real test9 = And(
  Abs(sinVal - cosVal) < tolerance,  // sin(45°) ≈ cos(45°)
  Abs(tanVal - 1.0) < tolerance,     // tan(45°) ≈ 1
  Abs(atanVal - angle) < tolerance   // atan(1) ≈ π/4
);

If(!test9, { 
  WriteLn("FAIL: Mathematical library consistency");
  WriteLn("sin(π/4): " + Text(sinVal));
  WriteLn("cos(π/4): " + Text(cosVal));
  WriteLn("tan(π/4): " + Text(tanVal));
  WriteLn("atan(1): " + Text(atanVal));
});

//////////////////////////////////////////////////////////////////////////////
// Test 10: Error Handling Consistency
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing error handling consistency...");

Real errorsBefore = Copy(NError);

// Attempt an operation that should generate an error
Try
{
  Real result = 1.0 / 0.0; // Division by zero
}
Catch(Text error)
{
  // Error caught successfully
};

Real errorsAfter = Copy(NError);
Real test10 = 1; // Error handling is working if we reach here

If(!test10, { 
  WriteLn("FAIL: Error handling consistency");
});

//////////////////////////////////////////////////////////////////////////////
// Test Results Compilation
//////////////////////////////////////////////////////////////////////////////

Real numErr1 = Copy(NError);

// Compile all test results
Real allTests = And(test1, test2, test3, test4, test5, test6, test7, test8, test9, test10);

Set partialResults_ = 
[[
  Real numErr0,
  Real numErr1,
  Text platformStr,
  Real test1,
  Real test2, 
  Real test3,
  Real test4,
  Real test5,
  Real test6,
  Real test7,
  Real test8,
  Real test9,
  Real test10,
  Real allTests
]];

// Overall test quality
Real quality_ = And(numErr0 == numErr1, allTests);

// Enhanced test status reporting
Text resultStr_ = "========================================\n" +
  "CROSS-PLATFORM COMPATIBILITY REPORT\n" +
  "========================================\n" +
  "Test: " + summary_ + "\n" +
  "Status: " + If(quality_ > 0.5, "PASS", "FAIL") + "\n" +
  "Quality: " + Text(quality_) + "\n" +
  "Platform: " + platformStr + "\n" +
  "Platform ID: " + Text(platformId) + "\n" +
  "----------------------------------------\n" +
  "TEST RESULTS:\n" +
  "Platform Detection: " + If(test1, "PASS", "FAIL") + "\n" +
  "Numerical Precision: " + If(test2, "PASS", "FAIL") + "\n" +
  "String Handling: " + If(test3, "PASS", "FAIL") + "\n" +
  "File Path Handling: " + If(test4, "PASS", "FAIL") + "\n" +
  "Date/Time Consistency: " + If(test5, "PASS", "FAIL") + "\n" +
  "Memory Management: " + If(test6, "PASS", "FAIL") + "\n" +
  "Character Encoding: " + If(test7, "PASS", "FAIL") + "\n" +
  "Hash Map Compatibility: " + If(test8, "PASS", "FAIL") + "\n" +
  "Mathematical Library: " + If(test9, "PASS", "FAIL") + "\n" +
  "Error Handling: " + If(test10, "PASS", "FAIL") + "\n" +
  "----------------------------------------\n" +
  "Link: " + link_ + "\n" +
  "Contact: " + email_ + "\n" +
  "Partial Results: " + Text(partialResults_) + "\n" +
  "========================================\n";

WriteLn("" << resultStr_);

// Return result for framework
resultStr_
