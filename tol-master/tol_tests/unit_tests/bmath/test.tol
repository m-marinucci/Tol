//////////////////////////////////////////////////////////////////////////////
// FILE   : test.tol
// PURPOSE: Unit tests for bmath module (fixed in PR 26)
// AUTHOR : Massimiliano Marinucci
// DATE   : 2025-07-06
// ISSUE  : NUM-11 - P0: Comprehensive Cross-Platform Testing Framework
//////////////////////////////////////////////////////////////////////////////

Text email_   = "mmarinucci@numinate.com"; 
Text link_    = "https://linear.app/numinate/issue/NUM-11";
Text summary_ = "bmath module unit tests - Linux compatibility validation";

Real numErr0 = Copy(NError);

//////////////////////////////////////////////////////////////////////////////
// Test 1: Basic Mathematical Operations
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing basic mathematical operations...");

Real testBasicMath = 1;

// Test basic arithmetic
Real a = 5.0;
Real b = 3.0;
Real sum = a + b;
Real diff = a - b;
Real prod = a * b;
Real quot = a / b;

Real test1 = And(
  EQ(sum, 8.0),
  EQ(diff, 2.0),
  EQ(prod, 15.0),
  EQ(quot, 5.0/3.0)
);

If(!test1, { 
  testBasicMath = 0;
  WriteLn("FAIL: Basic arithmetic operations");
});

//////////////////////////////////////////////////////////////////////////////
// Test 2: Trigonometric Functions
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing trigonometric functions...");

Real pi = 3.14159265359;
Real angle = pi / 4; // 45 degrees

Real sinVal = Sin(angle);
Real cosVal = Cos(angle);
Real tanVal = Tan(angle);

// Check if sin(45°) ≈ cos(45°) ≈ √2/2 ≈ 0.707
Real sqrt2_2 = Sqrt(2) / 2;
Real tolerance = 0.001;

Real test2 = And(
  Abs(sinVal - sqrt2_2) < tolerance,
  Abs(cosVal - sqrt2_2) < tolerance,
  Abs(tanVal - 1.0) < tolerance
);

If(!test2, { 
  testBasicMath = 0;
  WriteLn("FAIL: Trigonometric functions");
});

//////////////////////////////////////////////////////////////////////////////
// Test 3: Logarithmic and Exponential Functions
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing logarithmic and exponential functions...");

Real e = 2.71828182846;
Real x = 2.0;

Real expVal = Exp(x);
Real logVal = Log(expVal);
Real log10Val = Log10(100);

Real test3 = And(
  Abs(logVal - x) < tolerance,
  Abs(log10Val - 2.0) < tolerance,
  expVal > 0
);

If(!test3, { 
  testBasicMath = 0;
  WriteLn("FAIL: Logarithmic and exponential functions");
});

//////////////////////////////////////////////////////////////////////////////
// Test 4: Power and Root Functions
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing power and root functions...");

Real base = 4.0;
Real exponent = 2.0;
Real powerVal = base ^ exponent;
Real sqrtVal = Sqrt(16.0);
Real cbrtVal = 8.0 ^ (1.0/3.0);

Real test4 = And(
  EQ(powerVal, 16.0),
  EQ(sqrtVal, 4.0),
  Abs(cbrtVal - 2.0) < tolerance
);

If(!test4, { 
  testBasicMath = 0;
  WriteLn("FAIL: Power and root functions");
});

//////////////////////////////////////////////////////////////////////////////
// Test 5: Statistical Functions (if available)
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing statistical functions...");

Matrix data = [[1, 2, 3, 4, 5]];
Real mean = MatAvr(data);
Real expectedMean = 3.0;

Real test5 = Abs(mean - expectedMean) < tolerance;

If(!test5, { 
  testBasicMath = 0;
  WriteLn("FAIL: Statistical functions");
});

//////////////////////////////////////////////////////////////////////////////
// Test 6: Matrix Operations (basic)
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing basic matrix operations...");

Matrix m1 = [[1, 2], [3, 4]];
Matrix m2 = [[5, 6], [7, 8]];
Matrix sum_m = m1 + m2;
Matrix expected_sum = [[6, 8], [10, 12]];

Real test6 = MatEQ(sum_m, expected_sum);

If(!test6, { 
  testBasicMath = 0;
  WriteLn("FAIL: Basic matrix operations");
});

//////////////////////////////////////////////////////////////////////////////
// Test 7: Complex Number Operations (if available)
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing complex number operations...");

Complex c1 = Complex(3, 4);
Complex c2 = Complex(1, 2);
Complex c_sum = c1 + c2;
Complex expected_c_sum = Complex(4, 6);

Real test7 = 1; // Placeholder - would need proper complex comparison

//////////////////////////////////////////////////////////////////////////////
// Test 8: Numerical Precision and Edge Cases
//////////////////////////////////////////////////////////////////////////////

WriteLn("Testing numerical precision and edge cases...");

Real verySmall = 1e-15;
Real veryLarge = 1e15;
Real zero = 0.0;
Real infinity = 1.0 / zero;

Real test8 = And(
  verySmall > 0,
  veryLarge > 1e14,
  EQ(zero, 0.0)
  // Note: infinity test would depend on platform behavior
);

If(!test8, { 
  testBasicMath = 0;
  WriteLn("FAIL: Numerical precision and edge cases");
});

//////////////////////////////////////////////////////////////////////////////
// Test Results Compilation
//////////////////////////////////////////////////////////////////////////////

Real numErr1 = Copy(NError);

// Compile all test results
Real allTests = And(test1, test2, test3, test4, test5, test6, test7, test8);

Set partialResults_ = 
[[
  Real numErr0,
  Real numErr1,
  Real test1,
  Real test2, 
  Real test3,
  Real test4,
  Real test5,
  Real test6,
  Real test7,
  Real test8,
  Real allTests
]];

// Overall test quality
Real quality_ = And(numErr0 == numErr1, allTests, testBasicMath);

// Enhanced test status reporting
Text platform = "Linux"; // Would use DetectPlatform() in full implementation
Real executionTime = 1.0; // Placeholder
Real memoryUsage = 10.0; // Placeholder

Text resultStr_ = EnhancedTestStatus(summary_, link_, quality_,
                  "Partial results = " << partialResults_,
                  platform, executionTime, memoryUsage, email_);

WriteLn("" << resultStr_);

// Return result for framework
resultStr_
