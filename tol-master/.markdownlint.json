      "summary",
      "img",
      "br",
      "sub",
      "sup",
      "kbd",
      "mark"
    ]
  },
  "MD040": false,
  "MD041": {
    "front_matter_title": ""
  },
  "MD046": {
    "style": "fenced"
  },
  "MD048": {
    "style": "backtick"
  },
  "MD049": {
